<Project Sdk="Microsoft.NET.Sdk">

  <!-- Puente stdio -> HTTP para clientes que solo lanzan servidores locales (Claude Desktop).
       net48: viene incluido en Windows 10/11, no requiere instalar nada. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RevitMcpBridge</AssemblyName>
    <RootNamespace>RevitMcpBridge</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
