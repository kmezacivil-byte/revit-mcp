# ──────────────────────────────────────────────
#  RevitMCP Plugin — .gitignore
# ──────────────────────────────────────────────

# Visual Studio / VS Code artefactos
plugin/.vs/
*.user
*.suo
.vscode/

# Build intermediaries (.NET)
plugin/obj/
plugin/build-output/

# Simbolos de debug de todas las versiones (comentar para incluirlos)
plugin/build-output-*/*.pdb

# Instalador compilado (binario grande — regenerar con Inno Setup)
installer/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Claude Code
.claude/

# Logs de diagnóstico generados en runtime
*.log

# Puente (bridge)
bridge/obj/
bridge/bin/
bridge/build-output/

# Roslyn y dependencias de Revit 2025 (se regeneran al compilar)
plugin/build-output-2025/*
!plugin/build-output-2025/RevitMcpPlugin.dll
