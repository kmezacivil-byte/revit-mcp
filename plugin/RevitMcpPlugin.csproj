<Project Sdk="Microsoft.NET.Sdk">

  <!-- ════════════════════════════════════════════════════════════════
       Seleccionar versión de Revit al compilar:

         Revit 2021 :  dotnet build -c Release "-p:RevitVersion=2021"
         Revit 2022 :  dotnet build -c Release "-p:RevitVersion=2022"
         Revit 2023 :  dotnet build -c Release "-p:RevitVersion=2023"
         Revit 2024 :  dotnet build -c Release "-p:RevitVersion=2024"
         Revit 2025 :  dotnet build -c Release "-p:RevitVersion=2025"  (defecto)

       Constantes de compilación generadas automáticamente:
         REVIT<año>      — siempre (ej. REVIT2023)
         REVIT_NETFW     — net48, versiones 2021-2024
         REVIT_PRE2024   — ElementId.IntegerValue, versiones 2021-2023
       ════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <AssemblyName>RevitMcpPlugin</AssemblyName>
    <RootNamespace>RevitMcpPlugin</RootNamespace>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- ── Revit 2025 → .NET 8 ─────────────────────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputPath>build-output-2025\</OutputPath>
    <DefineConstants>REVIT2025</DefineConstants>
  </PropertyGroup>

  <!-- ── Revit 2021-2024 → .NET Framework 4.8 ────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' != '2025'">
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Sintaxis C# moderna (using var, ??=, etc.) en net48 -->
    <LangVersion>latest</LangVersion>
    <OutputPath>build-output-$(RevitVersion)\</OutputPath>
    <!-- REVIT_NETFW → estamos en .NET Framework; disponible en todos los net48 -->
    <DefineConstants>REVIT$(RevitVersion);REVIT_NETFW</DefineConstants>
  </PropertyGroup>

  <!-- ── Revit 2021-2023 → ElementId.IntegerValue (int) ──────────── -->
  <!--    Revit 2024 introdujo ElementId.Value (long) en net48 también -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2021' Or '$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023'">
    <DefineConstants>$(DefineConstants);REVIT_PRE2024</DefineConstants>
  </PropertyGroup>

  <!-- ── Referencias a Revit API y Newtonsoft.Json ────────────────── -->
  <!--    La ruta es consistente en todas las versiones:               -->
  <!--    C:\Program Files\Autodesk\Revit <año>\*.dll                  -->
  <!--    Private=false → no copiar al output (Revit ya los carga)     -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Newtonsoft.Json bundled con Revit — no añadir via NuGet -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
