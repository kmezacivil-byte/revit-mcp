<Project Sdk="Microsoft.NET.Sdk">

  <!-- ════════════════════════════════════════════════════════════════
       Seleccionar versión de Revit al compilar:

         Revit 2021 :  dotnet build -c Release "-p:RevitVersion=2021"
         Revit 2022 :  dotnet build -c Release "-p:RevitVersion=2022"
         Revit 2023 :  dotnet build -c Release "-p:RevitVersion=2023"
         Revit 2024 :  dotnet build -c Release "-p:RevitVersion=2024"
         Revit 2025 :  dotnet build -c Release "-p:RevitVersion=2025"  (defecto)
         Revit 2026 :  dotnet build -c Release "-p:RevitVersion=2026"  (.NET 8)
         Revit 2027 :  dotnet build -c Release "-p:RevitVersion=2027"  (.NET 10)
       Si el año pedido no está instalado, la API se toma de NuGet (Nice3point.Revit.Api.*).

       Constantes de compilación generadas automáticamente:
         REVIT<año>      — siempre (ej. REVIT2023)
         REVIT_NETFW     — net48, versiones 2021-2024
         REVIT_MODERN    — .NET 8/10, versiones 2025 en adelante (habilita execute_code)
         REVIT_PRE2024   — ElementId.IntegerValue, versiones 2021-2023
       ════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <AssemblyName>RevitMcpPlugin</AssemblyName>
    <RootNamespace>RevitMcpPlugin</RootNamespace>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- ── Revit 2025 y 2026 → .NET 8 ──────────────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputPath>build-output-$(RevitVersion)\</OutputPath>
    <DefineConstants>REVIT$(RevitVersion);REVIT_MODERN</DefineConstants>
  </PropertyGroup>

  <!-- ── Revit 2027 → .NET 10 ─────────────────────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputPath>build-output-2027\</OutputPath>
    <DefineConstants>REVIT2027;REVIT_MODERN</DefineConstants>
  </PropertyGroup>

  <!-- ── Revit 2021-2024 → .NET Framework 4.8 ────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Sintaxis C# moderna (using var, ??=, etc.) en net48 -->
    <LangVersion>latest</LangVersion>
    <OutputPath>build-output-$(RevitVersion)\</OutputPath>
    <!-- REVIT_NETFW → estamos en .NET Framework; disponible en todos los net48 -->
    <DefineConstants>REVIT$(RevitVersion);REVIT_NETFW</DefineConstants>
  </PropertyGroup>

  <!-- ── Revit 2021-2023 → ElementId.IntegerValue (int) ──────────── -->
  <!--    Revit 2024 introdujo ElementId.Value (long) en net48 también -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2021' Or '$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023'">
    <DefineConstants>$(DefineConstants);REVIT_PRE2024</DefineConstants>
  </PropertyGroup>

  <!-- ── Referencias a Revit API y Newtonsoft.Json ────────────────── -->
  <!--    La ruta es consistente en todas las versiones:               -->
  <!--    C:\Program Files\Autodesk\Revit <año>\*.dll                  -->
  <!--    Private=false → no copiar al output (Revit ya los carga)     -->
  <ItemGroup Condition="Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Newtonsoft.Json bundled con Revit — no añadir via NuGet -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Sin esa versión de Revit instalada: API desde NuGet (Nice3point.Revit.Api.*), así se compila cualquier año (2021-2027).
       Se excluye el runtime: en tiempo de ejecución las DLL las aporta Revit. Newtonsoft.Json también viene con Revit. -->
  <ItemGroup Condition="!Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- ── Revit 2025+ (REVIT_MODERN): motor de scripts (Roslyn) para la tool execute_code ───
       Roslyn no viene con Revit, así que se distribuye junto al plugin (Microsoft.CodeAnalysis*.dll). -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026' Or '$(RevitVersion)' == '2027'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026' Or '$(RevitVersion)' == '2027'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

  <!-- ── Autenticación (Supabase): HttpClient y DPAPI en .NET Framework. En .NET 8/10 ProtectedData ya viene en Microsoft.WindowsDesktop.App. ── -->
  <ItemGroup Condition="'$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
