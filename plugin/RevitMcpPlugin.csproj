<Project Sdk="Microsoft.NET.Sdk">

  <!-- ════════════════════════════════════════════════════════
       Seleccionar versión de Revit al compilar:
         Revit 2025 (defecto):  dotnet build -c Release
         Revit 2021:            dotnet build -c Release /p:RevitVersion=2021
       ════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <AssemblyName>RevitMcpPlugin</AssemblyName>
    <RootNamespace>RevitMcpPlugin</RootNamespace>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- ── Revit 2025 → .NET 8 ──────────────────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputPath>build-output\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- ── Revit 2021 → .NET Framework 4.8 ─────────────────── -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2021'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>build-output-2021\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <!-- Permitir sintaxis moderna de C# (using var, ??=) en net48 -->
    <LangVersion>latest</LangVersion>
    <!-- Símbolo para compilación condicional de API de Revit 2021 -->
    <DefineConstants>REVIT2021</DefineConstants>
  </PropertyGroup>

  <!-- ── Referencias Revit 2025 ───────────────────────────── -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Referencias Revit 2021 ───────────────────────────── -->
  <!-- Newtonsoft.Json ya viene con Revit (no copiar — usar el de Revit) -->
  <ItemGroup Condition="'$(RevitVersion)' == '2021'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2021\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2021\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files\Autodesk\Revit 2021\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
